// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1781684372091893905 @name=Tk
window-rule {
    match app-id="^Tk$"
    open-floating true
}

// @id=wr_1781713146057883813 @name=Spotify
window-rule {
    match app-id="^Spotify$"
    open-on-workspace "4"
}

// @id=wr_1781713340569828166 @name=equibop
window-rule {
    match app-id="^equibop$"
    open-on-workspace "3"
    default-column-width { fixed 640; }
}

// @id=wr_1781713355012165607 @name=equibop
window-rule {
    match app-id="^equibop$"
    default-column-width { fixed 1000; }
}

// @id=wr_1782386380210087719 @name=Spotify
window-rule {
    match app-id="^Spotify$"
    open-floating true
}
