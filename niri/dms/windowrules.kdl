// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1794753794269175169 @name=discord
window-rule {
    match app-id="^discord$"
    open-on-workspace "3"
}

// @id=wr_1794756989222244605 @name=librewolf
window-rule {
    match app-id="^librewolf$"
    open-on-workspace "2"
}

// @id=wr_1794892785309662764 @name=Spotify
window-rule {
    match app-id="^Spotify$"
    open-on-workspace "4"
}

// @id=wr_1795068933301096407 @name=zen
window-rule {
    match app-id="^zen$"
    open-on-workspace "2"
    min-width 0
}

// @id=wr_1795200426848851229 @name=dev.duxlabs.files
window-rule {
    match app-id="^dev.duxlabs.files$"
    open-floating true
}

// @id=wr_1795202207529363342 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    open-floating true
}

// @id=wr_1795202308902445162 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    open-floating true
}

// @id=wr_1795332730351865540 @name=org.prismlauncher.PrismLauncher
window-rule {
    match app-id="^org.prismlauncher.PrismLauncher$" is-floating=true
}

// @id=wr_1795332739052468048 @name=org.prismlauncher.PrismLauncher
window-rule {
    match app-id="^org.prismlauncher.PrismLauncher$"
    open-floating true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
