config-notification {
    disable-failed
}
output "HDMI-A-1" {
    mode "1920x1080@74.973"
    scale 1.0
    transform "normal"
    position x=0 y=0
}

gestures {
    hot-corners {
        off
    }
}

input {
     keyboard {
        xkb {
           // options "altwin:swap_alt_win"
            layout "us" // Use the American keyboard layout
        }
        numlock // Enable numlock on startup
     }
    focus-follows-mouse
}

layout {
    background-color "transparent"
    always-center-single-column
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    border {
        on
        width 1
        active-color "#616161"
        inactive-color "#61616180"
        urgent-color "#cc4444"
    }
    focus-ring{
        off
    }
    shadow {
	on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    struts {
    }
}

overview {
    workspace-shadow {
        off
    }
}

environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORMTHEME "qt6ct"
}
hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
	off
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

window-rule {
    match app-id=r"^org\.wezfurlong\.wezterm$"
    default-column-width {
    }
}
window-rule {
    match app-id=r"^org\.gnome\."
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id=r"^gnome-control-center$"
    match app-id=r"^pavucontrol$"
    match app-id=r"^nm-connection-editor$"
    default-column-width { proportion 0.5; }
    open-floating false
}
window-rule {
    match app-id=r"^org\.gnome\.Calculator$"
    match app-id=r"^gnome-calculator$"
    match app-id=r"^galculator$"
    match app-id=r"^blueman-manager$"
    match app-id=r"^xdg-desktop-portal$"
    open-floating true
}
window-rule {
    match app-id=r"^steam$" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
window-rule {
    match app-id=r"^org\.wezfurlong\.wezterm$"
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}
window-rule {
    match app-id=r"firefox$" title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

debug {
    honor-xdg-activation-with-invalid-serial
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="workspace"; }
        Alt+Shift+Tab   { previous-window scope="workspace"; }
    }
}
window-rule {
    match app-id="^zen$"
    open-on-workspace "2"
    default-column-width { proportion 0.8; }
}
window-rule {
    match app-id="^discord$"
    open-on-workspace "3"
}
window-rule {
    match app-id="^Spotify$"
    open-on-workspace "4"
}
window-rule {
    match app-id="^com.obsproject.Studio$"
    open-on-workspace "4"
}

/-window-rule {
    opacity 0.8
    background-effect {
        blur true
	xray false
        noise 0.01
    }
}
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
        xray false
        noise 0.01
    } 
    shadow {
	on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
 }
workspace "1"
workspace "2"
workspace "3"
workspace "4"

//include "dms/colors.kdl" optional=true
include "dms/layout.kdl" optional=true
include "dms/alttab.kdl" optional=true
include "dms/binds.kdl" optional=true
include "dms/outputs.kdl" optional=true
include "dms/cursor.kdl" optional=true
include "dms/input.kdl" optional=true
include "dms/windowrules.kdl"
